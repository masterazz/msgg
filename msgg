#!/usr/bin/env bash
#################################################
# static gallery generator                      #
# mailto: master@masteraz.ru                    #
#################################################

# Determine script directory
SCRIPT_DIR="$(dirname "$(realpath "$0")")"

# Default sizes for thumbnails and previews
THUMB_SIZE="150x150>"
PREVIEW_SIZE="800x800>"

# Check if ImageMagick is installed
if ! command -v convert &> /dev/null; then
    echo "Error: ImageMagick is not installed. Please install it to use this script."
    exit 1
fi

# Check if head.inc and end.inc exist
if [ ! -f "$SCRIPT_DIR/head.inc" ]; then
    echo "Warning: $SCRIPT_DIR/head.inc not found. Proceeding without it."
    HEAD_INC=""
else
    HEAD_INC="$SCRIPT_DIR/head.inc"
fi

if [ ! -f "$SCRIPT_DIR/end.inc" ]; then
    echo "Warning: $SCRIPT_DIR/end.inc not found. Proceeding without it."
    END_INC=""
else
    END_INC="$SCRIPT_DIR/end.inc"
fi

# Check if directory is provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 <dirname>"
    exit 1
fi

# Check if directory exists
if [ ! -d "$1" ]; then
    echo "Error: Directory '$1' does not exist."
    exit 1
fi

cd "$1" || { echo "Error: Cannot change to directory '$1'"; exit 1; }

# Create thumb and prev directories if they don't exist
mkdir -p thumb prev || { echo "Error: Cannot create directories"; exit 1; }

# Generate HTML for individual preview page
#1 - current file
#2 - next file
#3 - previous file
generate_prev()
{
    local current="$1"
    local next="$2"
    local prev="$3"
    {
        echo '<!DOCTYPE html>'
        echo '<html lang="en">'
        echo '<head>'
        echo '    <meta charset="UTF-8">'
        echo "    <title>$gname - $current</title>"
        echo '    <style>'
        echo '        body { text-align: center; font-family: Arial, sans-serif; }'
        echo '        .gallery { margin: auto; max-width: 800px; }'
        echo '        img { max-width: 100%; height: auto; }'
        echo '        .nav { display: flex; justify-content: space-between; margin: 10px 0; }'
        echo '    </style>'
        echo '</head>'
        echo '<body>'
	[ -n "$HEAD_INC" ] && cat "$HEAD_INC"
        echo '    <div class="gallery">'
        echo "        <h1>$gname</h1>"
        echo "        <p><a href=\"../$current\"><strong>Original Size</strong></a></p>"
        echo "        <p><a href=\"$next.html\"><img src=\"pr$current\" alt=\"$current\"></a></p>"
        echo "        <img src=\"pr$next\" width=\"0\" height=\"0\" alt=\"preload\">"
        echo '        <div class="nav">'
        echo "            <a href=\"$prev.html\"><strong>Previous</strong></a>"
        echo "            <a href=\"$next.html\"><strong>Next</strong></a>"
        echo '        </div>'
        echo '        <p><a href="../index.html"><strong>Back to Gallery</strong></a></p>'
        [ -n "$END_INC" ] && cat "$END_INC"
        echo '    </div>'
        echo '</body>'
        echo '</html>'
    } > "prev/$current.html"
}

# Generate index entry for thumbnail
generate_index_entry()
{
    cat << EOF >> index.html
<td>
    <a href="prev/$1.html"><img src="thumb/th$1" alt="$1"></a>
</td>
EOF
}

#generating header

gname=$1
coln=0
prevn=
pprevn=
first=
second=
start=0

# Generate index.html
{
    echo '<!DOCTYPE html>'
    echo '<html lang="en">'
    echo '<head>'
    echo '    <meta charset="UTF-8">'
    echo "    <title>$gname Gallery</title>"
    echo '    <style>'
    echo '        body { text-align: center; font-family: Arial, sans-serif; }'
    echo '        .gallery { margin: auto; max-width: 1200px; }'
    echo '        table { margin: auto; }'
    echo '        img { max-width: 150px; height: auto; }'
    echo '    </style>'
    echo '</head>'
    echo '<body>'
    [ -n "$HEAD_INC" ] && cat "$HEAD_INC"
    echo '    <div class="gallery">'
    echo "        <h1>$gname</h1>"
    echo '        <table>'
    echo '            <tbody>'
    echo '                <tr>'
} > index.html

# Process JPG files
shopt -s nullglob  # Avoid issues if no JPG files exist
for file in *.[Jj][Pp][Gg]
do
    if [ ! -f "$file" ]; then
        echo "No JPG files found in directory."
        break
    fi
    echo "Processing $file"
    echo "Generating thumbnail"
    convert "$file" -resize "$THUMB_SIZE" "thumb/th$file" || { echo "Error generating thumbnail for $file"; exit 1; }
    echo "Generating preview"
    convert "$file" -resize "$PREVIEW_SIZE" "prev/pr$file" || { echo "Error generating preview for $file"; exit 1; }
    echo "Generating html"
    generate_index_entry "$file"
    if [ $start = 0 ]
    then
	first=$file
	start=1
    elif [ $start = 1 ]
    then
	second=$file
	start=2
    elif [ $start = 2 ]
    then
        generate_prev "$prevn" "$file" "$pprevn"
    fi
    pprevn=$prevn
    prevn=$file
    ((coln++))
    if [ $coln = 5 ]
    then
	echo "</tr>" >> index.html
	echo "<tr>" >> index.html
	coln=0
    fi
done

# Generate final preview pages
if [ -n "$first" ]; then
    generate_prev "$file" "$first" "$pprevn"
    generate_prev "$first" "$second" "$file"
else
    echo "No images processed, skipping preview generation."
fi

#generate end

{
    echo '                </tr>'
    echo '            </tbody>'
    echo '        </table>'
    [ -n "$END_INC" ] && cat "$END_INC"
    echo '    </div>'
    echo '</body>'
    echo '</html>'
} >> index.html

echo "Gallery generated successfully."
